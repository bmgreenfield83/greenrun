MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=running_tracker
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated exact browser origins allowed by FastAPI CORS.
# Add your Tailscale address without replacing the localhost entries, for example:
# FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://100.x.y.z:5174
FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# For access from another device, set this to the backend computer's Tailscale IP or MagicDNS name.
# Example: VITE_API_BASE_URL=http://100.x.y.z:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
# IP addresses are accepted automatically. If using MagicDNS, list the hostname here.
# Example: VITE_ALLOWED_HOSTS=my-computer.example-tailnet.ts.net
VITE_ALLOWED_HOSTS=
STORAGE_LIMIT_BYTES=536870912
MAX_FIT_UPLOAD_BYTES=52428800
