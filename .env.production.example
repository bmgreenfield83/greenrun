# Greenrun on the Beelink: copy to .env and fill in. Never commit .env.
# Atlas connection string (Atlas > Connect > Drivers). Keep it out of shell history and logs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster>
MONGODB_DATABASE=running_tracker
APP_ENV=production
# Loopback port on the Beelink that Tailscale Serve proxies to.
GREENRUN_PORT=8440
STORAGE_LIMIT_BYTES=536870912
MAX_FIT_UPLOAD_BYTES=52428800
# Garmin Connect sync (optional). Read only by the backend. Sign in once with the setup command;
# see docs/garmin-sync.md. GARMIN_TOKEN_DIR defaults to ~/.garminconnect (/data/garmin in Docker).
GARMIN_EMAIL=
GARMIN_PASSWORD=
